<!--
    ダークテーマの色定義。
    キーの一覧は Light.xaml と必ず一致させる（ThemeManager が丸ごと入れ替えるため）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 面 -->
    <SolidColorBrush x:Key="Brush.Window.Bg" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="Brush.Surface.Alt" Color="#FF262626" />

    <!-- 枠線 -->
    <SolidColorBrush x:Key="Brush.Border" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#FF515151" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="Brush.Text" Color="#FFF1F1F1" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#FFACACAC" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#FF6E6E6E" />

    <!-- 状態 -->
    <SolidColorBrush x:Key="Brush.Hover" Color="#FF383838" />
    <SolidColorBrush x:Key="Brush.Pressed" Color="#FF444444" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#FF33404F" />

    <!-- コントロール -->
    <SolidColorBrush x:Key="Brush.Control.Bg" Color="#FF333333" />
    <SolidColorBrush x:Key="Brush.Control.Hover" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="Brush.Control.Pressed" Color="#FF484848" />
    <SolidColorBrush x:Key="Brush.Input.Bg" Color="#FF272727" />

    <!-- バッジ -->
    <SolidColorBrush x:Key="Brush.Badge.Bg" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="Brush.Badge.Text" Color="#FFCFCFCF" />

    <!-- 連番のカード -->
    <SolidColorBrush x:Key="Brush.Seq.Bg" Color="#FF37331F" />
    <SolidColorBrush x:Key="Brush.Seq.Border" Color="#FF5C5330" />
    <SolidColorBrush x:Key="Brush.Seq.Text" Color="#FFDFD1A4" />

    <!-- プレビュー -->
    <SolidColorBrush x:Key="Brush.Preview.Bg" Color="#FF23272E" />
    <SolidColorBrush x:Key="Brush.Preview.Text" Color="#FFD6E3F5" />

    <!-- その他 -->
    <SolidColorBrush x:Key="Brush.Separator" Color="#FF4C4C4C" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#FF5A5A5A" />
    <SolidColorBrush x:Key="Brush.ScrollThumb.Hover" Color="#FF7C7C7C" />
    <SolidColorBrush x:Key="Brush.Toast.Bg" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="Brush.Toast.Border" Color="#FF4A4A4A" />

    <!-- アクセント（ThemeManager が Windows のアクセント色で上書きする） -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF4CA0E0" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#FF64AFE6" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#FF7CBDEB" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FF10222F" />

</ResourceDictionary>
