<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyTitle>MyTaskTray</AssemblyTitle>
    <Product>MyTaskTray</Product>

    <!--
      SYSLIB1054: DllImport ではなく LibraryImport を使う提案。
      LibraryImport が生成するマーシャリングコードは unsafe を含むため
      AllowUnsafeBlocks が必要になるが、その利点（Native AOT / トリミング対応）は
      WPF アプリでは得られない。P/Invoke はごく少数で呼び出し頻度も低く、
      プロジェクト全体で unsafe を許可するほどの理由がないため抑制する。
    -->
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      UseWindowsForms は System.Windows.Forms / System.Drawing を暗黙 using に追加するため、
      WPF の System.Windows と型名が衝突する (MessageBox, Application など)。
      暗黙 using から外し、必要なファイルだけで明示的に using する。
    -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!--
      tools\ 配下は本体に含めない。
      このプロジェクトはリポジトリのルートにあるため、既定では **\*.cs を拾ってしまい、
      確認用ツール (tools\ClipboardProbe) のソースまで本体へ取り込まれる。
      Main が重複するなど、原因の分かりにくいビルドエラーになる。
    -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Page Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <!--
      このプロジェクト唯一の外部依存。Markdown を HTML へ変換するために入れている。
      CommonMark の仕様に忠実であることに手を掛ける価値は薄いと判断した（DESIGN_RICH_COPY.md §5-1）。

      net10.0 向けの依存パッケージが 0 個なので、増える DLL はこれ 1 つだけ。
      ライセンスは BSD-2-Clause。
      差し替えたくなった場合に触るのは Services\MarkdownRenderer.cs だけで済むようにしてある。
    -->
    <PackageReference Include="Markdig" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
