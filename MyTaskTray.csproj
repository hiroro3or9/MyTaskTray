<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <AssemblyTitle>MyTaskTray</AssemblyTitle>
    <Product>MyTaskTray</Product>

    <!--
      SYSLIB1054: DllImport ではなく LibraryImport を使う提案。
      LibraryImport が生成するマーシャリングコードは unsafe を含むため
      AllowUnsafeBlocks が必要になるが、その利点（Native AOT / トリミング対応）は
      WPF アプリでは得られない。P/Invoke は 2 つだけで呼び出し頻度も低く、
      プロジェクト全体で unsafe を許可するほどの理由がないため抑制する。
    -->
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      UseWindowsForms は System.Windows.Forms / System.Drawing を暗黙 using に追加するため、
      WPF の System.Windows と型名が衝突する (MessageBox, Application など)。
      暗黙 using から外し、必要なファイルだけで明示的に using する。
    -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

</Project>
